    "nano-staged": "1.0.2",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
